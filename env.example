# ==============================
# Bot Simpan Uang — Konfigurasi
# ==============================

# WAJIB: Token dari @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Opsional: Path database SQLite (default: ./data/money.db)
DB_PATH=./data/money.db

# Opsional: Zona waktu (default: Asia/Jakarta)
TIMEZONE=Asia/Jakarta

# Opsional: Waktu default reminder harian (HH:MM)
REMINDER_TIME=20:00

# Opsional: Chat ID untuk backup otomatis DB setiap malam 22:00
# (bisa chat ID pribadi atau grup)
BACKUP_CHAT_ID=

# Opsional: Google Sheets ID untuk sinkronisasi (perlu modul sheets)
GOOGLE_SHEETS_ID=

# Opsional: Path ke file JSON service account Google
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opsional: URL publik dashboard Flask (untuk Telegram Mini App)
# Contoh pakai ngrok: https://abc123.ngrok-free.app
# Contoh pakai Railway: https://money-bot-dashboard.up.railway.app
DASHBOARD_URL=
