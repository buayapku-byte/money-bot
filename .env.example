# ─── Telegram ────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ─── WhatsApp ────────────────────────────────────────────
# Path folder untuk nyimpen session WA (auto-created)
WA_SESSION_PATH=./data/wa-session

# ─── Database ────────────────────────────────────────────
DB_PATH=./data/money.db

# ─── Reminder default ────────────────────────────────────
# Format HH:MM, timezone Asia/Jakarta
REMINDER_TIME=20:00
TIMEZONE=Asia/Jakarta

# ─── Optional ────────────────────────────────────────────
# Set ke 'true' untuk matiin log verbose Baileys
SILENT_WA=true
