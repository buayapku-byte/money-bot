# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ─── WhatsApp ──────────────────────────────────────────────
WA_SESSION_PATH=./data/wa-session
WA_PHONE_NUMBER=628xxxxxxxxxx
SILENT_WA=false

# ─── Database ──────────────────────────────────────────────
DB_PATH=./data/money.db

# ─── Reminder ──────────────────────────────────────────────
REMINDER_TIME=20:00
TIMEZONE=Asia/Jakarta

# ─── OCR (Foto Struk) ──────────────────────────────────────
# Daftar gratis di https://ocr.space/ocrapi — key default: helloworld
OCR_API_KEY=helloworld

# ─── Auto-Backup ke Telegram ───────────────────────────────
# Isi BACKUP_CHAT_ID → backup file .db dikirim HARIAN ke chat ini (jam 22:00 WIB)
# Cara dapat Chat ID: forward pesan ke @userinfobot atau @RawDataBot
# Kosongkan = backup MINGGUAN ke semua wallet (perilaku default)
BACKUP_CHAT_ID=

# ─── Google Sheets Sync ─────────────────────────────────────
# 1. Buat Service Account di Google Cloud Console
# 2. Aktifkan Google Sheets API
# 3. Share spreadsheet ke email service account (Editor)
# 4. Isi GOOGLE_SHEETS_ID (dari URL spreadsheet)
# 5. Isi GOOGLE_SERVICE_ACCOUNT_JSON (isi JSON credentials sebagai satu baris)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
